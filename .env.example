# 登录自己的上游账号后填写；本文件只是配置示例
FANZHA_BASE_URL=https://xzfzznt.gaj.sh.gov.cn
FANZHA_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE
FANZHA_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_HERE

# 可选：仅聊天请求发送 X-Chat-Key；填入自己确认的有效值，留空不发送
FANZHA_CHAT_KEY=
DEFAULT_MODEL=fanzha-ai

# 默认保持本机访问；非回环HOST必须设置PROXY_API_KEY
HOST=127.0.0.1
PORT=8088
PROXY_API_KEY=
TRUST_ENV_PROXY=false

# 额外可信的浏览器源，例 https://chat.example.com；不支持*
CORS_ORIGINS=

# 可选的刷新凭证持久化；推荐 .fanzha-token-state.json（已被git忽略）
# 仅支持单进程使用，不要指向.env或源码文件
TOKEN_STATE_FILE=

MAX_REQUEST_BODY_BYTES=33554432
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_UPSTREAM_RESPONSE_BYTES=8388608
MAX_CHAT_CHARS=128000
MAX_TTS_CHARS=20000

# 已确认上游总会发送结束标记后才能启用
UPSTREAM_REQUIRE_DONE=false
